          }
        ],
        [
          {
            "type": "text",
            "value": "底层是映射类型（mapped type），形如 "
          },
          {
            "type": "code",
            "value": "{ [K in keyof T]?: T[K] }"
          },
          {
            "type": "text",
            "value": "，懂这点就能自己写派生。"
          }
        ],
        [
          {
            "type": "text",
            "value": "同类还有 "
          },
          {
            "type": "code",
            "value": "Required"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "Readonly"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "Omit"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "Record"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "ReturnType"
          },
          {
            "type": "text",
            "value": "，按需组合。"
          }
        ],
        [
          {
            "type": "strong",
            "value": "示例："
          },
          {
            "type": "text",
            "value": "Partial / Pick 作用在同一类型。"
          }
        ],
        [
          {
            "type": "code",
            "value": "type User = { id: number; name: string; age: number }\ntype UserPatch = Partial<User>           // 字段全可选\ntype UserLite = Pick<User, 'id' | 'name'> // 只留两字段"
          }
        ]
      ]

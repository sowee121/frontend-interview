          {
            "type": "code",
            "value": "void"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "text",
            "value": "2、永远抛错、死循环、穷尽检查剩下的分支，用 "
          },
          {
            "type": "code",
            "value": "never"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "text",
            "value": "3、"
          },
          {
            "type": "code",
            "value": "never"
          },
          {
            "type": "text",

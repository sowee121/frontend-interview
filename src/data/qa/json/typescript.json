        ],
        [
          {
            "type": "text",
            "value": "2、从 "
          },
          {
            "type": "code",
            "value": "unknown"
          },
          {
            "type": "text",
            "value": " 出来应先收窄或校验，再断言；双重断言尽量别用，容易把错类型硬盖过去。"
          }
        ],
        [
          {
            "type": "text",
            "value": "3、优先 "
          },
          {
            "type": "code",
            "value": "in"
          },
          {
            "type": "text",
            "value": " / 谓词 / 判别联合；断言留在边界层（DOM、JSON）。"
          }
        ]
      ]
    },

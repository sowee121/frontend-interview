          {
            "type": "strong",
            "value": "要点："
          },
          {
            "type": "code",
            "value": "strict"
          },
          {
            "type": "text",
            "value": " 开了之后，原先 JS 里「能跑」的写法，编译期就会拦下来。"
          }
        ],
        [
          {
            "type": "code",
            "value": "strictNullChecks"
          },
          {
            "type": "text",
            "value": "："
          },
          {
            "type": "code",
            "value": "null"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",
            "value": "undefined"
          },
          {
            "type": "text",
            "value": " 不能赋给 "
          },
          {
            "type": "code",
            "value": "string"
          },
          {
            "type": "text",
            "value": "，要用 "
          },
          {
            "type": "code",
            "value": "string | null"
          },
          {
            "type": "text",
            "value": " 或可选链 "
          },
          {
            "type": "code",
            "value": "?."
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "code",
            "value": "noImplicitAny"
          },
          {
            "type": "text",
            "value": "：参数、变量推断不出类型就报隐式 "
          },
          {
            "type": "code",
            "value": "any"
          },
          {
            "type": "text",
            "value": "，得补注解。"
          }
        ],
        [
          {
            "type": "code",
            "value": "strict"
          },
          {
            "type": "text",
            "value": " 是总开关，不能按目录分段开；渐进迁移可以先开子开关（如先 "
          },
          {
            "type": "code",
            "value": "noImplicitAny"
          },
          {
            "type": "text",
            "value": " 再 "
          },
          {
            "type": "code",
            "value": "strictNullChecks"
          },
          {
            "type": "text",
            "value": "），或用多份 "
          },
          {
            "type": "code",
            "value": "tsconfig"
          },
          {
            "type": "text",
            "value": " 分范围覆盖。"

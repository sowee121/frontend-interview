            "type": "code",
            "value": "a || b"
          },
          {
            "type": "text",
            "value": " 会把所有假值都换成 "
          },
          {
            "type": "code",
            "value": "b"
          },
          {
            "type": "text",
            "value": "。例如 "
          },
          {
            "type": "code",
            "value": "count ?? 0"
          },
          {
            "type": "text",
            "value": " 能保留 "
          },
          {
            "type": "code",
            "value": "0"
          },
          {
            "type": "text",
            "value": "，而 "
          },
          {
            "type": "code",
            "value": "count || 0"
          },
          {
            "type": "text",
            "value": " 会把 0 误当成「未设置」。"
          }
        ],
        [
          {
            "type": "text",
            "value": "注意："
          },
          {
            "type": "code",
            "value": "??"
          },
          {
            "type": "text",
            "value": " 不能与 "
          },
          {
            "type": "code",
            "value": "||"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "&&"
          },
          {
            "type": "text",
            "value": " 直接混用，"
          },
          {
            "type": "code",
            "value": "a ?? b || c"
          },
          {
            "type": "text",
            "value": " 会报语法错误，需写成 "
          },
          {
            "type": "code",
            "value": "(a ?? b) || c"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "strong",
            "value": "示例："
          },
          {
            "type": "text",
            "value": "可选链与空值合并同输入对比。"
          }
        ],
        [
          {
            "type": "code",
            "value": "const user = { profile: null }\nuser.profile?.name      // undefined，不抛错\nuser.profile.name       // 抛错\n\n0 || 42   // 42（0 会被 || 当成假）\n0 ?? 42   // 0（只有 null/undefined 才用右侧）"
          }
        ]
      ]
    }
  ]
}

          },
          {
            "type": "text",
            "value": " 换掉当前页；"
          },
          {
            "type": "code",
            "value": "switchTab"
          },
          {
            "type": "text",
            "value": " 切 tabBar；"
          },
          {
            "type": "code",
            "value": "reLaunch"
          },
          {
            "type": "text",
            "value": " 清空栈后重启；"
          },
          {
            "type": "code",
            "value": "navigateBack"
          },
          {
            "type": "text",
            "value": " 按 delta 回退。"

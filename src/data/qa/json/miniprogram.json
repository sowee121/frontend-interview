          {
            "type": "code",
            "value": "onPullDownRefresh"
          },
          {
            "type": "text",
            "value": "、触底 "
          },
          {
            "type": "code",
            "value": "onReachBottom"
          },
          {
            "type": "text",
            "value": "、滚动 "
          },
          {
            "type": "code",
            "value": "onPageScroll"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "text",
            "value": "5）实践：每次可见时在 "
          },
          {
            "type": "code",
            "value": "onShow"
          },
          {
            "type": "text",
            "value": " 拉数据；在 "
          },
          {
            "type": "code",
            "value": "onLoad"
          },
          {
            "type": "text",
            "value": " 读路由参数；在 "
          },
          {
            "type": "code",
            "value": "onUnload"
          },
          {
            "type": "text",
            "value": " 清理定时器与订阅。"
          }
        ],
        [
          {
            "type": "strong",
            "value": "示例："

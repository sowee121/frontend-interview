          },
          {
            "type": "text",
            "value": "，"
          },
          {
            "type": "code",
            "value": "navigateTo"
          },
          {
            "type": "text",
            "value": " 进不去。"
          },
          {
            "type": "code",
            "value": "reLaunch"
          },
          {

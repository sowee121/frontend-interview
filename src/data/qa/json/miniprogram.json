            "type": "text",
            "value": "（冷启动）、"
          },
          {
            "type": "code",
            "value": "onShow"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",
            "value": "onHide"
          },
          {
            "type": "text",
            "value": "（前后台切换），另有 "
          },
          {
            "type": "code",
            "value": "onError"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",
            "value": "onPageNotFound"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "text",
            "value": "2）Page："
          },
          {
            "type": "code",
            "value": "onLoad"
          },
          {
            "type": "text",
            "value": "（入参 "
          },
          {
            "type": "code",
            "value": "options"
          },
          {
            "type": "text",
            "value": "）、"
          },
          {
            "type": "code",
            "value": "onShow"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "onReady"
          },
          {
            "type": "text",
            "value": "（首屏渲染完成）、"
          },
          {
            "type": "code",
            "value": "onHide"
          },
          {
            "type": "text",
            "value": "、"
          },
          {
            "type": "code",
            "value": "onUnload"
          },
          {
            "type": "text",
            "value": "（出栈销毁）。"
          }
        ],
        [
          {
            "type": "text",
            "value": "3）Component："
          },
          {
            "type": "code",
            "value": "attached"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",
            "value": "ready"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",
            "value": "detached"
          },
          {
            "type": "text",
            "value": "，对应挂载、就绪与卸载；另有 "

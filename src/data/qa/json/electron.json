          {
            "type": "code",
            "value": "BrowserWindow"
          },
          {
            "type": "text",
            "value": " 对应一套页面，运行 Vue/React；默认不应直接访问 Node。"
          }
        ],
        [
          {
            "type": "text",
            "value": "3、"
          },
          {
            "type": "strong",
            "value": "preload"
          },
          {
            "type": "text",
            "value": "：窗口加载前注入，用 "

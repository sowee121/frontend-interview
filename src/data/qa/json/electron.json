    {
      "id": "q-electron-update",
      "navLabel": "自动更新实现",
      "question": "Electron 自动更新应如何实现？检查、下载、安装如何串联？",
      "questionNote": "常用 electron-updater；主进程负责更新流程与失败回退。",
      "answer": [
        [
          {
            "type": "strong",
            "value": "要点："
          },
          {
            "type": "text",
            "value": "主进程用更新库读远端 latest 元数据 → 比对版本 → 下载安装包 → 校验 → 退出时静默安装；渲染层只展示进度与按钮。"
          }
        ],
        [
          {
            "type": "code",
            "value": "// main.js — electron-updater 示意\nconst { autoUpdater } = require('electron-updater');\nconst { BrowserWindow, ipcMain } = require('electron');\n\nautoUpdater.autoDownload = false; // 先询用户或业务空闲再下\n\nfunction setupAutoUpdate() {\n  autoUpdater.checkForUpdates();\n\n  autoUpdater.on('update-available', (info) => {\n    // 通知渲染：有新版本\n    BrowserWindow.getAllWindows()[0]?.webContents.send('update:available', info);\n  });\n\n  autoUpdater.on('download-progress', (p) => {\n    BrowserWindow.getAllWindows()[0]?.webContents.send('update:progress', {\n      percent: p.percent,\n    });\n  });\n\n  autoUpdater.on('update-downloaded', () => {\n    BrowserWindow.getAllWindows()[0]?.webContents.send('update:downloaded');\n  });\n\n  autoUpdater.on('error', (err) => {\n    BrowserWindow.getAllWindows()[0]?.webContents.send('update:error', String(err));\n  });\n}\n\nipcMain.handle('update:startDownload', async () => {\n  await autoUpdater.downloadUpdate();\n});\n\nipcMain.handle('update:quitAndInstall', () => {\n  autoUpdater.quitAndInstall(); // 退出并安装已下载包\n});"
          }
        ],
        [
          {
            "type": "text",
            "value": "1、"
          },
          {
            "type": "strong",
            "value": "配置来源"
          },
          {
            "type": "text",
            "value": "：builder 的 "
          },
          {
            "type": "code",
            "value": "publish.url"
          },
          {
            "type": "text",
            "value": " 指向静态目录或 GitHub Releases；客户端启动后 "
          },
          {
            "type": "code",
            "value": "checkForUpdates"
          },
          {
            "type": "text",
            "value": " 拉 "
          },
          {
            "type": "code",
            "value": "latest.yml"
          },
          {
            "type": "text",
            "value": " 比版本。"
          }
        ],
        [
          {
            "type": "text",
            "value": "2、"
          },
          {
            "type": "strong",
            "value": "签名与校验"
          },
          {
            "type": "text",
            "value": "：Windows 需代码签名；macOS 必须同时完成代码签名与公证（notarization），否则新版本装上后会被系统直接拦下。两类系统都应配置签名，兼顾防篡改与可安装。"
          }
        ],
        [
          {
            "type": "text",
            "value": "3、"
          },
          {
            "type": "strong",
            "value": "自助机"
          },
          {
            "type": "text",
            "value": "：业务空闲时再 "
          },
          {
            "type": "code",
            "value": "quitAndInstall"
          },
          {
            "type": "text",
            "value": "；失败提示并保留旧版可运行，必要时提供手动装包兜底。"
          }
        ]
      ]
    },

            "type": "text",
            "value": "2、"
          },
          {
            "type": "strong",
            "value": "状态隔离："
          },
          {
            "type": "text",
            "value": "内存按 "
          },
          {
            "type": "code",
            "value": "conversationId → messages[]"
          },
          {
            "type": "text",
            "value": " 分桶；流式气泡只写回「开流时记下的那个 Id」。"
          }
        ],
        [
          {
            "type": "text",
            "value": "切会话先 "
          },
          {
            "type": "code",
            "value": "abort"

            "type": "code",
            "value": "const el = document.getElementById('msg-list') // 消息列表滚动容器\nlet content = '' // 当前助手气泡文案\nlet pending = '' // 先拼字，不每个 token 都触发渲染\nlet raf = 0\nlet follow = true // 是否贴底自动滚动\n\nfunction onDelta(text) { // 每收到一段 delta.content 调用\n  pending += text\n  if (raf) return // 本帧已排队，等一起刷\n  raf = requestAnimationFrame(() => {\n    content += pending // 合并写入，减少重渲染\n    pending = ''\n    raf = 0\n    if (follow) el.scrollTop = el.scrollHeight // 仅贴底时追滚\n  })\n}\n\nconst NEAR = 80 // 距底多少像素算「还在底部」\nel.addEventListener('scroll', () => {\n  const distance = el.scrollHeight - el.scrollTop - el.clientHeight\n  follow = distance <= NEAR // 上滑离开底部后不再强制滚到底\n})"
          }
        ]

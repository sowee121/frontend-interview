            "type": "code",
            "value": "// —— 服务端推过来的帧（示意）——\n// 增量：拼 delta.content\ndata: {\"choices\":[{\"delta\":{\"content\":\"你\"},\"finish_reason\":null}]}\n\n// 收尾：finish_reason 有值，content 常为空\ndata: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n// 流正常结束\ndata: [DONE]\n\n// —— 前端防双流错乱 ——\nlet requestId = 0 // 全局当前轮次\nlet content = '' // 当前助手气泡\nconst myId = ++requestId // 本轮开流时记下\n// 停止或切会话时：requestId++ ，旧轮 myId 全部失效\nfunction onChunk(json) {\n  if (myId !== requestId) return // 已不是本轮，丢弃迟到数据\n  content += json.choices?.[0]?.delta?.content ?? ''\n}"
          }
        ]
      ]

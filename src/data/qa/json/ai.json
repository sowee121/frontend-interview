          {
            "type": "code",
            "value": "// token=用户登录态（不是模型 Key）；model/input 为入参\nconst abort = new AbortController()\nlet content = '' // 当前助手气泡文案\nconst res = await fetch('/api/chat', {\n  method: 'POST',\n  headers: {\n    'Content-Type': 'application/json',\n    Authorization: `Bearer ${token}`,\n  },\n  body: JSON.stringify({\n    model,\n    stream: true, // 开启流式\n    messages: [{ role: 'user', content: input }],\n  }),\n  signal: abort.signal, // 停止/卸载时 abort.abort()\n})\n// 不是 SSE 就别当流式读\nif (!res.ok || !res.headers.get('content-type')?.includes('text/event-stream')) {\n  throw new Error('bad stream')\n}\nconst reader = res.body.getReader() // 按块读响应体\nconst decoder = new TextDecoder()\nlet buf = '' // 拼接不完整的 SSE 半包\ntry {\n  while (true) {\n    const { done, value } = await reader.read()\n    if (done) break // 连接结束 ≠ 业务完成，还要看 [DONE]\n    buf += decoder.decode(value, { stream: true }) // 保留跨块半字符\n    const parts = buf.split('\\n\\n') // SSE 事件以空行分隔\n    buf = parts.pop() ?? '' // 最后一段可能不完整，留到下次\n    for (const part of parts) {\n      const line = part.split('\\n').find((l) => l.startsWith('data: '))\n      if (!line) continue\n      const data = line.slice('data: '.length) // 去掉前缀，剩下 JSON 或 [DONE]\n      if (data === '[DONE]') return // 正常结束\n      const json = JSON.parse(data)\n      const text = json.choices?.[0]?.delta?.content // 本帧增量文本\n      if (text) content += text // 拼到当前助手消息\n    }\n  }\n} catch (err) {\n  if (err?.name === 'AbortError') return // 用户取消，不当失败\n  throw err\n}"
          }
        ]
      ]

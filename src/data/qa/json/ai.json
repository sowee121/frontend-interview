          },
          {
            "type": "code",
            "value": "fetch"
          },
          {
            "type": "text",
            "value": "；同时 "
          },
          {
            "type": "code",
            "value": "requestId++"
          },
          {
            "type": "text",
            "value": "，丢弃迟到的 "
          },
          {
            "type": "code",
            "value": "delta.content"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],

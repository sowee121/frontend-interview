          {
            "type": "code",
            "value": "const ctrl = new AbortController()\nlet requestId = 0\nlet content = ''\nlet pending = '' // rAF 合并时，先攒着还没写入 content\nlet raf = 0\nlet streaming = false\n\n// 开流：const myId = ++requestId; fetch(..., { signal: ctrl.signal })\n// 用户点停止，或 beforeUnmount / onBeforeUnmount：\nctrl.abort() // 打断 fetch\nrequestId++ // 旧回调 if (myId !== requestId) return\nif (raf) {\n  cancelAnimationFrame(raf)\n  raf = 0\n}\nif (pending) {\n  content += pending // 未刷屏的字立刻写入\n  pending = ''\n}\nstreaming = false"
          }
        ]
      ]

          {
            "type": "text",
            "value": "，并 "
          },
          {
            "type": "code",
            "value": "overflow:hidden"
          },
          {
            "type": "text",
            "value": "。"
          }
        ],
        [
          {
            "type": "text",
            "value": "3、容器要有限宽；当 flex 子项时往往还要 "
          },
          {
            "type": "code",
            "value": "min-width:0"
          },
          {
            "type": "text",
            "value": "。"
          }
        ]
      ]
    },

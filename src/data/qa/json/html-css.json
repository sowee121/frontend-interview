            "type": "text",
            "value": "1、"
          },
          {
            "type": "code",
            "value": "display:none"
          },
          {
            "type": "text",
            "value": "：不占位、不渲染；"
          },
          {
            "type": "code",
            "value": "visibility:hidden"
          },
          {
            "type": "text",
            "value": "：占位不可见。"
          }
        ],
        [
          {
            "type": "text",
            "value": "2、"
          },
          {
            "type": "code",
            "value": "opacity:0"
          },
          {
            "type": "text",
            "value": "：仍可命中事件（除非再 "
          },
          {
            "type": "code",
            "value": "pointer-events:none"

          },
          {
            "type": "code",
            "value": "pnpm workspace"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",
            "value": "Nx"
          },
          {
            "type": "text",
            "value": " / "
          },
          {
            "type": "code",

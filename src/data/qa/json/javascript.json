          {
            "type": "text",
            "value": "；需同时覆盖 null 与 undefined 时，"
          },
          {
            "type": "code",
            "value": "x == null"
          },
          {
            "type": "text",
            "value": " 是少数可接受的 "
          },
          {
            "type": "code",
            "value": "=="
          },
          {
            "type": "text",
            "value": " 用法，其余比较宜用 "
          },
          {
            "type": "code",
            "value": "==="
          },
          {
            "type": "text",
            "value": "。"
          }
        ]
      ]

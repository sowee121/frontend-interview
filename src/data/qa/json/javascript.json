          },
          {
            "type": "text",
            "value": " 做 rAF 节流。"
          }
        ],
        [
          {
            "type": "strong",
            "value": "示例："
          },
          {
            "type": "text",
            "value": "防抖骨架。"
          }
        ],
        [
          {
            "type": "code",
            "value": "function debounce(fn, wait) {\n  let t\n  return function (...args) {\n    clearTimeout(t) // 每次触发先取消上一次\n    t = setTimeout(() => fn.apply(this, args), wait) // 静止 wait 后再跑\n  }\n}\n// 搜索：onInput={debounce(fetchList, 300)}"
          }

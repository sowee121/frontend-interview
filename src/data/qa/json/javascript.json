          },
          {
            "type": "text",
            "value": "：将 "
          },
          {
            "type": "code",
            "value": "fn"
          },
          {
            "type": "text",
            "value": " 挂到 "
          },
          {
            "type": "code",
            "value": "context"
          },
          {
            "type": "text",
            "value": " 临时属性上调用，执行后删除；用 "
          },
          {
            "type": "code",
            "value": "Symbol"
          },
          {
            "type": "text",
            "value": " 可避免键名冲突。"
